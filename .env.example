# Application Environment Configuration
# COPY THIS FILE TO .env AND POPULATE APPROPRIATE VALUES
# NEVER COMMIT .env TO REPOSITORY

# Execution Mode: RESEARCH, BACKTEST, PAPER (LIVE IS STRICTLY PROHIBITED)
APP_ENV=RESEARCH
LOG_LEVEL=INFO

# Market Data Settings
DATA_PROVIDER=SIMULATED
HISTORICAL_DATA_DIR=./data/processed
MARKET_DATA_DIR=./data/market_data
DUCKDB_PATH=./data/market_data/analytics.duckdb
DEFAULT_HISTORICAL_PROVIDER=mock
DEFAULT_TIMEFRAME=1d
MAX_QUOTE_STALENESS_SECONDS=30.0
YAHOO_FINANCE_TIMEOUT_SECONDS=10.0

# Regulatory & Operational Safety
ENABLE_LIVE_TRADING=false
REQUIRE_PAPER_CONFIRMATION=true
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_LIMIT_PCT=0.05
MAX_POSITION_SIZE_PCT=0.01

# Storage
DATABASE_URL=sqlite:///./hybrid_agent.db
